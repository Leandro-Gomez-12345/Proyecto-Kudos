meta {
  name: Vincular persona a programa academico
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/vinculaciones-academicas
  body: json
  auth: none
}

body:json {
  {
    "usuario": { "id": "{{idUsuario}}" },
    "programaAcademico": { "id": "{{idPrograma}}" },
    "fechaVinculacion": "2026-01-15"
  }
}

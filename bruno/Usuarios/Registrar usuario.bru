meta {
  name: Registrar usuario
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/usuarios
  body: json
  auth: none
}

body:json {
  {
    "usuario": {
      "nombre": "Ana",
      "apellido": "Perez",
      "correoInstitucional": "ana.perez@uco.edu.co",
      "celular": "3001234567",
      "rol": { "id": "{{idRol}}" }
    },
    "programas": [
      { "id": "{{idPrograma}}" }
    ]
  }
}

meta {
  name: Presentar nuevamente registro
  type: http
  seq: 2
}

put {
  url: http://localhost:8080/api/v1/usuarios/:id/registro
  body: json
  auth: none
}

params:path {
  id: {{idUsuario}}
}

body:json {
  {
    "usuario": {
      "nombre": "Ana",
      "apellido": "Perez",
      "correoInstitucional": "ana.perez@uco.edu.co",
      "celular": "3001234567",
      "rol": { "id": "{{idRol}}" }
    },
    "programas": [
      { "id": "{{idPrograma}}" }
    ]
  }
}

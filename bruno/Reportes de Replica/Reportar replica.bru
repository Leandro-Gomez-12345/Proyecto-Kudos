meta {
  name: Reportar replica
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/reportes-replica
  body: json
  auth: none
}

body:json {
  {
    "replica": { "id": "{{idReplica}}" },
    "motivo": { "id": "{{idMotivo}}" },
    "descripcion": "El contenido no es apropiado para la plataforma"
  }
}

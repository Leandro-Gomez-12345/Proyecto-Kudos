meta {
  name: Reportar Kudo
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/reportes-kudo
  body: json
  auth: none
}

body:json {
  {
    "kudo": { "id": "{{idKudo}}" },
    "motivo": { "id": "{{idMotivo}}" },
    "descripcion": "El contenido no es apropiado para la plataforma"
  }
}

vars:pre-request {
  idKudo: 01a1f1dd-b0d4-78e2-9e21-40f47de7b201
  idMotivo: feff2162-e305-11f1-ab4d-d543cf46f0df
}

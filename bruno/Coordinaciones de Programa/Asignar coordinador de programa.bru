meta {
  name: Asignar coordinador de programa
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/coordinaciones-programa
  body: json
  auth: none
}

body:json {
  {
    "usuario": { "id": "{{idUsuario}}" },
    "programaAcademico": { "id": "{{idPrograma}}" },
    "fechaInicio": "2026-01-15"
  }
}

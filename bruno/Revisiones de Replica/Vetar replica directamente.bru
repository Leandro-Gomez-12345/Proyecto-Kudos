meta {
  name: Vetar replica directamente
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/v1/revisiones-replica/veto-directo
  body: json
  auth: none
}

body:json {
  {
    "replica": { "id": "{{idReplica}}" },
    "justificacion": "El contenido incumple las normas de la comunidad"
  }
}
